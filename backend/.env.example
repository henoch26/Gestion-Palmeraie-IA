# ================================================================
# FICHIER DE CONFIGURATION — BACKEND DJANGO
# ================================================================
# 1. Copier ce fichier en ".env" (supprimer l'extension .example)
# 2. Remplir TOUTES les valeurs marquees REMPLACER_PAR_...
# 3. NE JAMAIS committer le fichier .env dans Git !
# ================================================================


# --- SECURITE ---

# Cle secrete Django — generer avec la commande :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=REMPLACER_PAR_UNE_CLE_LONGUE_ET_ALEATOIRE

# Mettre False en production, True uniquement en developpement local
DEBUG=False


# --- DOMAINES AUTORISES ---

# Domaine(s) du serveur, separes par des virgules, SANS https://
# Exemple : mondomaine.com,www.mondomaine.com
ALLOWED_HOSTS=TON_DOMAINE.com,www.TON_DOMAINE.com

# Origines frontend autorisees — AVEC https://
# Doit correspondre exactement au domaine du frontend
CORS_ALLOWED_ORIGINS=https://TON_DOMAINE.com,https://www.TON_DOMAINE.com

# Origines autorisees pour les requetes CSRF (admin Django)
CSRF_TRUSTED_ORIGINS=https://TON_DOMAINE.com,https://www.TON_DOMAINE.com


# --- BASE DE DONNEES PostgreSQL ---

# Nom de la base de donnees
DB_NAME=gestion_palmeraie

# Nom d'utilisateur PostgreSQL
DB_USER=palmeraie_user

# Mot de passe de la base de donnees
DB_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_BD

# Adresse du serveur PostgreSQL (localhost si sur le meme serveur)
DB_HOST=localhost

# Port PostgreSQL — par defaut 5432 sur un serveur Ubuntu neuf
DB_PORT=5432


# --- EMAIL (optionnel) ---
# Laisser vide pour desactiver l'envoi d'emails (mode console)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
